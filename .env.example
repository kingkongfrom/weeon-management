# =============================================================================
# Weeon Management — environment configuration
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` (it is git-ignored).
#
# Keys come from: Supabase Dashboard → Project → Settings → API.
# Weeon Management shares the SAME single Supabase project used by
# `weeon-admin` and `weeon-school`.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Public "anon" key. Safe to ship to the browser — RLS is the security boundary.
# NEVER put the service_role key here.
SUPABASE_ANON_KEY=

# Project reference (short alphanumeric id, used by management tooling).
SUPABASE_PROJECT_REF=

# ---------------------------------------------------------------------------
# PLATFORM / server-only — read docs/architecture.md + docs/security.md first.
#
# Service-role key. BYPASSES RLS — this is how Weeon Management sees ACROSS
# ALL TENANTS (the anon/tenant-scoped RLS would hide other schools from us).
# Must ONLY ever be used server-side (a route handler / server action or RSC
# with its own platform-authorization). NEVER expose it via NEXT_PUBLIC_* or
# the anon/browser client.
#
# Weeon Management reads tenant data from the PLATFORM scope, NOT the
# tenant-scoped RLS model used by weeon-admin. Keep these two paths separate.
SUPABASE_SERVICE_ROLE_KEY=

# Deployment environment (not the same as NODE_ENV).
# development | production (also used by sibling repos; keep consistent).
# ENVIRONMENT=development
# ---------------------------------------------------------------------------

# --- Weeon Ops origin (branded invite / reset links) -----------------------
# Canonical public origin of THIS console. Production: https://ops.weeon.school
# Must be allowlisted in Supabase Auth → URL configuration.
# WEEON_OPS_ORIGIN=https://ops.weeon.school

# --- Branded transactional email (Resend) ----------------------------------
# Invite, password-reset, and /dashboard/email compose mail use THIS app.
# Do NOT use Supabase Auth's generic invite/recovery emails for ops staff.
# RESEND_API_KEY=
# RESEND_FROM=Weeon School <hello@weeon.school>
# Optional Reply-To when the signed-in ops user is not @weeon.school (defaults to support@weeon.school).
# OPS_EMAIL_REPLY_TO=support@weeon.school

# Inbound (Resend Receiving): webhook signing secret from Resend → Webhooks
# (event: email.received). Webhook URL: https://ops.weeon.school/api/webhooks/resend
# RESEND_WEBHOOK_SECRET=whsec_...
# Optional comma-separated inbox addresses to store (default: accept all Resend forwards).
# After DNS: docs/email-dns-receiving.md (use inbound.weeon.school — not apex @)
# OPS_INBOUND_ADDRESSES=ops@inbound.weeon.school,support@weeon.school

# --- Compose: Google Drive + Dropbox (same public keys as weeon-tenants) ---
# Dropbox: App Console → app key (NOT the secret) → authorized origins include
# https://ops.weeon.school (and http://localhost:3000 in dev).
# NEXT_PUBLIC_DROPBOX_APP_KEY=
# Google Cloud: OAuth client (Web) + Picker API key + numeric project id.
# Authorized JavaScript origins: https://ops.weeon.school , http://localhost:3000
# NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
# NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY=
# NEXT_PUBLIC_GOOGLE_DRIVE_APP_ID=

# Optional comma-separated extra ops emails (dev). Default directory is
# eduardo@weeon.school only — never copy tenant school-admins into this list.
# AUTH_ALLOWED_STAFF_EMAILS=

# --- Optional: cross-repo shared secret (auto snapshot CRON) ---------------
# Same value as weeon-admin → /api/backup/autosnapshot so we can surface
# platform backup health here (read-only overview).
# CRON_SECRET=

# --- School provisioning (guided demo) -------------------------------------
# Base origin of the school ERP that owns tenant creation + the MEP catalog.
# Production: https://app.weeon.school
WEEON_APP_ORIGIN=https://app.weeon.school

# Shared secret for the ops → ERP provisioning API (/api/ops/schools/*).
# Must be >= 16 characters and IDENTICAL to OPS_PROVISIONING_SECRET in
# weeon-tenants. Server-only — never expose to the browser.
# OPS_PROVISIONING_SECRET=
