{
  "name": "weeon-management",
  "version": "0.1.0",
  "private": true,
  "description": "Weeon Ops — internal platform operations dashboard for the Weeon School. Cross-tenant oversight: tenants, users per tenant, tenant stats, subscription health.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "render:email-logo": "tsx scripts/render-logo-wordmark.tsx",
    "copy:maplibre-worker": "tsx scripts/copy-maplibre-worker.ts",
    "predev": "npm run copy:maplibre-worker",
    "prebuild": "npm run render:email-logo && npm run copy:maplibre-worker",
    "postinstall": "npm run copy:maplibre-worker"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^1.40.0",
    "maplibre-gl": "^6.11.2",
    "motion": "^13.2.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.3",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "geist": "^1.7.2",
    "playwright": "^1.58.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
